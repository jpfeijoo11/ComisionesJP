@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-primary fw-bold mb-4">Sistema de Comisiones JP</h1>
    <p class="lead text-secondary">
        Proyecto de Ingeniería Web desarrollado por Juan Feijoo.
    </p>

    <div class="mt-5 p-4 bg-light rounded-3 shadow-sm d-inline-block">
        <h4 class="mb-3">Módulo Mini-Core</h4>
        <p>Calculadora dinámica de comisiones por rango de fechas.</p>
        
        <a asp-controller="Comisiones" asp-action="Index" class="btn btn-primary btn-lg mt-2 px-5">
            Entrar a la Calculadora
        </a>
    </div>
</div>
