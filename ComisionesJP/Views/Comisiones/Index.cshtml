@model IEnumerable<ComisionesJP.Models.ResumenComisionViewModel>

@{
    ViewData["Title"] = "Cálculo de Comisiones";
}

<div class="container mt-4">
    <h2 class="text-primary mb-4">Calculadora de Comisiones (Mini-Core)</h2>

    <div class="card shadow-sm p-4 mb-5">
        <form asp-action="Index" method="post" class="row g-3">
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Inicio:</label>
                <input type="date" name="fechaInicio" class="form-control" value="@ViewBag.FechaInicio" required />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold">Fecha Fin:</label>
                <input type="date" name="fechaFin" class="form-control" value="@ViewBag.FechaFin" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">Vendedor (Opcional):</label>
                <select name="vendedorId" class="form-select" asp-items="@ViewBag.Vendedores">
                    <option value="">-- Todos los vendedores --</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-success w-100">
                    Filtrar
                </button>
            </div>
        </form>
    </div>

    @if (Model != null && Model.Any())
    {
        <h4 class="mb-3">Resultados del Periodo</h4>
        <div class="table-responsive">
            <table class="table table-hover table-bordered shadow-sm text-center align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Vendedor</th>
                        <th>Total Ventas del Rango</th>
                        <th>% de Comisión Aplicado</th>
                        <th>Total a Pagar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.NombreVendedor</td>
                            <td>$@item.TotalVentas.ToString("0.00")</td>
                            <td><span class="badge bg-secondary fs-6">@item.PorcentajeAplicado.ToString("0.##")%</span></td>
                            <td class="fw-bold text-success fs-5">$@item.ComisionCalculada.ToString("0.00")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model != null && !Model.Any())
    {
        <div class="alert alert-warning text-center fw-bold">
            No se encontraron ventas para los filtros seleccionados.
        </div>
    }
</div>